# .env.example — copy this to .env for local development
# Never commit .env to git!

# ─── Cloudinary (optional — skip if using local file storage) ───────────────
# Get from: cloudinary.com → Dashboard → "API Environment variable"
# Format:  cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── PostgreSQL (Neon) ────────────────────────────────────────────────────
# Get this from your Neon dashboard → Project → Connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Flask ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# ─── Admin account (only used on first run / fresh database) ──────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ─── Production mode ──────────────────────────────────────────────────────
# Set to 1 on server, leave unset or 0 for local dev
HKPS_PRODUCTION=0
COOKIE_SECURE=0
